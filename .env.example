# Copy this file to .env.local and fill in real values. .env* files are not committed.
OPENAI_API_KEY=
# Optional: override the default model (default: gpt-4o-mini)
OPENAI_MODEL=
# 1 = demo mode: never call the model, use authored content only
DEMO_MODE=
# Optional: comma-separated production origins allowed to call the API
ALLOWED_ORIGIN=https://cyberstage.vercel.app
